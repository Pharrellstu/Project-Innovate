# Only include src/ and public/ directories
# Ignore everything at root level first
/*

# Then explicitly include what we want
!src/
!public/
!.gitignore
!README.md

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/
dist/
dist-ssr/
*.local

# Build outputs
build/
out/

# Configuration files (explicitly ignored)
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
vite.config.ts
tsconfig*.json
eslint.config.js
index.html

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache directories
.npm
.eslintcache
.parcel-cache
.cache

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/

# Temporary folders
tmp/
temp/
